VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
GROQ_API_KEY=
# Server-side only. Never prefix this key with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Show the LossLens Protection concept teaser and /protection page. Counsel must approve the wording before the site goes public.
VITE_SHOW_PROTECTION=on
# Payments (Premium only). off | sandbox | live — default off.
PAYMENTS_MODE=off
# Price shown/charged for Premium in KES.
PREMIUM_PRICE_KES=500
# M-Pesa Daraja (required when PAYMENTS_MODE=live).
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# AI chat rolling quotas (api/chat.js). Plans with aiPriority use the priority pair.
CHAT_QUOTA_PER_HOUR=30
CHAT_QUOTA_PER_DAY=150
CHAT_QUOTA_PRIORITY_PER_HOUR=90
CHAT_QUOTA_PRIORITY_PER_DAY=400
# Shared secret for GET /api/cron/expire-subscriptions (bearer header or ?secret=).
CRON_SECRET=
